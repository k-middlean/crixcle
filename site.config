# Crixcle Gateway: Public Web Experience & Orchestration Layer
<VirtualHost *:80>
        ServerAdmin webmaster@localhost

        ServerName crixcle-dev.com
        ServerAlias www.crixcle-dev.com api.crixcle-dev.com

        DocumentRoot /home/akshay/workstation/web/crixcle/crixcle.com

        # Required modules
        RewriteEngine On
        ProxyPreserveHost On

        <Directory /home/akshay/workstation/web/crixcle/crixcle.com>
                AllowOverride None
                Options -Indexes +FollowSymLinks
                Require all granted

                # Symfony front controller fallback
                RewriteEngine On
                # Capture and expose the Authorization header as an environment variable
                RewriteCond %{HTTP:Authorization} ^(.*)
                RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

                RewriteCond %{REQUEST_FILENAME} !-f
                RewriteCond %{REQUEST_FILENAME} !-d
                RewriteRule ^ index.php [QSA,L]
        </Directory>

        ErrorLog ${APACHE_LOG_DIR}/middlean_error.log
        CustomLog ${APACHE_LOG_DIR}/middlean_access.log combined
</VirtualHost>

# Vite Dev Environment Configs
<VirtualHost *:80>
        ServerName ux.crixcle-dev.com

        # --- Required modules ---
        # a2enmod rewrite proxy proxy_http proxy_wstunnel headers
        RewriteEngine On
        ProxyPreserveHost On

        # --- API -> Symfony backend (bypass Vite) ---
        # This must be BEFORE any Vite rewrites or the catch-all ProxyPass
        <Location /api/>
                ProxyPreserveHost Off
                ProxyPass        http://api.crixcle-dev.com/api/
                ProxyPassReverse http://api.crixcle-dev.com/api/
        </Location>

        # --- Static assets via Apache ---
        ProxyPass /assets !
        Alias /assets /home/akshay/workstation/web/crixcle/crixcle.com/assets
        <Directory /home/akshay/workstation/web/crixcle/crixcle.com/assets>
                Options -Indexes +FollowSymLinks
                AllowOverride None
                Require all granted
        </Directory>

        # --- HMR WebSocket upgrade (Vite dev server) ---
        RewriteCond %{HTTP:Upgrade} =websocket [NC]
        RewriteCond %{HTTP:Connection} upgrade [NC]
        RewriteRule ^/?(.*)$ ws://localhost:5173/$1 [P,L]

        # --- Ensure Vite internal endpoints bypass our custom rewrites ---
        # /@vite/*, /@react-refresh, /@id/*, /@fs/*, plus /node_modules/* and /src/*
        RewriteRule ^/@(vite|react-refresh|id|fs)(/.*)?$ http://localhost:5173%{REQUEST_URI} [P,L,QSA]
        RewriteRule ^/(node_modules|src)(/.*)?$         http://localhost:5173%{REQUEST_URI} [P,L,QSA]

        # --- Robots: deindex user-posted (L5) articles, but NOT Vite internals ---
        <LocationMatch "^/@(?!vite|react-refresh|id|fs)[A-Za-z0-9._-]+/[A-Za-z0-9-]+/?$">
                Header set X-Robots-Tag "noindex, nofollow"
        </LocationMatch>

        # -------------------------
        # HTML route rewrites below
        # -------------------------

        # 0) Home -> /index.html
        RewriteRule ^$ http://localhost:5173/index.html [P,L]

        # 5) Programs: /(work|services|contact)
        RewriteCond %{REQUEST_URI} ^/(work|services|contact)/?$ [NC]
        RewriteRule ^ http://localhost:5173/pages/%1/index.html [P,L]

        # --- Fallback to Vite dev server (HTTP) ---
        ProxyPass        / http://localhost:5173/
        ProxyPassReverse / http://localhost:5173/

        ErrorLog  ${APACHE_LOG_DIR}/crixcle_dev_error.log
        CustomLog ${APACHE_LOG_DIR}/crixcle_dev_access.log combined
</VirtualHost>